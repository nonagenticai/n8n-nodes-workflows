{
  "name": "@nonagentic/n8n-nodes-workflows",
  "version": "0.2.0",
  "description": "n8n node for managing workflows and executions on a running n8n instance",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "workflows",
    "executions",
    "self-management"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nonagentic.ai",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint \"nodes/**/*.ts\" \"credentials/**/*.ts\"",
    "format": "prettier --write \"**/*.ts\"",
    "docs": "node generate-docs.js",
    "postbuild": "npm run docs",
    "test": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --testPathIgnorePatterns=integration",
    "test:all": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest",
    "test:watch": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --watch --testPathIgnorePatterns=integration",
    "test:coverage": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --coverage --testPathIgnorePatterns=integration"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "replaySafe": false,
    "credentials": [
      "dist/credentials/WorkflowsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Workflows/Workflows.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.0",
    "gulp": "^5.0.1",
    "jest": "^30.2.0",
    "jest-util": "^30.2.0",
    "n8n-workflow": "^1.120.7",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {},
  "overrides": {
    "form-data": "^4.0.4",
    "isolated-vm": "7.0.2"
  },
  "author": {
    "name": "NonAgenticAI",
    "url": "https://nonagentic.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonagenticai/n8n-nodes-workflows.git"
  }
}
